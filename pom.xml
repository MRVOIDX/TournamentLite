<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>net.tournamentslite</groupId>
    <artifactId>TournamentsLite</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>

    <name>TournamentsLite</name>
    <description>Lightweight Folia-native tournament sign-up plugin with GUI.</description>
    <url>https://github.com/MRVOIDX/TournamentLite</url>

    <developers>
        <developer>
            <name>MrVoidx</name>
        </developer>
    </developers>

    <scm>
        <url>https://github.com/MRVOIDX/TournamentLite</url>
        <connection>scm:git:https://github.com/MRVOIDX/TournamentLite.git</connection>
        <developerConnection>scm:git:https://github.com/MRVOIDX/TournamentLite.git</developerConnection>
    </scm>

    <properties>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!--
            Bump this if your server jar reports a different API version.
            Paper's API artifact version always mirrors the Minecraft version
            it targets, e.g. Minecraft 1.21.11 -> paper-api 1.21.11-R0.1-SNAPSHOT.
            Folia uses the exact same API artifact/coordinates as Paper.
        -->
        <paper.version>1.21.11-R0.1-SNAPSHOT</paper.version>
    </properties>

    <repositories>
        <repository>
            <id>papermc</id>
            <url>https://repo.papermc.io/repository/maven-public/</url>
        </repository>
    </repositories>

    <dependencies>
        <dependency>
            <groupId>io.papermc.paper</groupId>
            <artifactId>paper-api</artifactId>
            <version>${paper.version}</version>
            <scope>provided</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>${project.artifactId}-${project.version}</finalName>
        <defaultGoal>package</defaultGoal>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
            </plugin>
        </plugins>
    </build>
</project>
